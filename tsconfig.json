{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "ignoreDeprecations": "6.0",
    "strict": true
  },
  "include": ["**/*.ts", "**/*.tsx", "src"],
  "exclude": ["**/node_modules", "**/Pods"]
}
